# bookmarkd server configuration
BOOKMARKS_ADDR=127.0.0.1:8080
# Local dev can use a relative path. Production should use an absolute path, e.g.
# /var/lib/bookmarks/data/bookmarks.db
BOOKMARKS_DBPATH=./data/bookmarks.db
BOOKMARKS_TOKEN=replace-with-random-token

# Production only (see docs/operations.md). Unset disables the offsite copy.
# BOOKMARKS_BACKUP_DIR=/var/backups/bookmarks
# BOOKMARKS_OFFSITE_TOOL=rsync
# BOOKMARKS_OFFSITE_DEST=backup@backup.example.net:bookmarks/
# RSYNC_RSH="ssh -i /root/.ssh/bookmarks-offsite -o BatchMode=yes"
